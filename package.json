{
  "name": "aurora-v2",
  "version": "2.0.0",
  "license": "GPL-3.0-only",
  "author": "Morgan N aka Ichoui",
  "description": "Aurorapp Northern Lights, available on the Play Store only, for Northern Lights Chasers",
  "scripts": {
    "start:front": "ng serve",
    "build": "ng build",
    "lint": "ng lint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "start:back": "cd ../aurora-back && npm start",
    "android:open": "npx cap open android",
    "android:dev:watch": "ionic cap sync --watch --prod",
    "android:copy-files": "npx cap copy",
    "android:update-files": "npx cap update",
    "android:build:prod": "ng build --configuration=production",
    "android:sync": "cap sync android",
    "android:create": "npx cap add android",
    "android:sync-styles": "cp src/styles.xml android/app/src/main/res/values/styles.xml",
    "android:generate-logos-assets": "npx capacitor-assets generate --android --iconBackgroundColor '#001e49' --iconBackgroundColorDark '#001e49' --splashBackgroundColor '#001e49' --splashBackgroundColorDark '#001e49' --assetPath src/assets",
    "deploy": "npm run android:build:prod && npm run android:generate-logos-assets && npm run android:sync-styles && npm run android:sync",
    "info:ionic": "ionic info",
    "prettier": "prettier --write \"**/*.{js,ts,css,scss,html}\"",
    "prettier:check": "prettier --check \"**/*.{js,ts,css,scss,html}\"",
    "prettier-html": "prettier --write \"src/**/*.html\""
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@ionic/angular": "^9.0.8",
    "@ionic/core": "^9.0.8",
    "@ionic/storage": "^4.0.0",
    "@ionic/storage-angular": "^4.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "cordova-sqlite-storage": "^7.0.0",
    "leaflet": "^1.9.4",
    "localforage-cordovasqlitedriver": "^1.8.0",
    "lottie-web": "^5.13.0",
    "moment": "^2.31.0",
    "ngx-lottie": "^22.0.0",
    "rxjs": "^7.8.2",
    "swiper": "^14.3.0",
    "tslib": "^2.8.1",
    "ionicons": "^8.1.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/cli": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@ionic/angular-toolkit": "^13.0.0",
    "@types/node": "^26.6.5",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "typescript": "~6.0.3"
  }
}
