{
  "name": "aurora-v2",
  "version": "2.0.0",
  "licence": "GPL-3.0-only",
  "author": "Morgan N aka Ichoui",
  "description": "Aurorapp Northern Lights, available on the Play Store only, for Northern Lights Chasers",
  "scripts": {
    "start:front": "ionic serve",
    "start:back": "cd ../aurora-back && npm start",
    "android:open": "npx cap open android",
    "android:dev:watch": "ionic cap sync --watch --prod",
    "android:copy-files": "npx cap copy",
    "android:update-files": "npx cap update",
    "android:build:prod": "ionic build --prod",
    "android:create": "npx cap add android",
    "android:trapeze": "npx trapeze run trapeze-config.yaml --android-project android",
    "android:generate-logos-assets": "npx capacitor-assets generate --android --iconBackgroundColor '#001e49' --iconBackgroundColorDark '#001e49' --splashBackgroundColor '#001e49' --splashBackgroundColorDark '#001e49' --assetPath src/assets",
    "deploy": "npm run android:build:prod && npm run android:create && npm run android:generate-logos-assets && npm run android:trapeze && npm run android:update-files && npm run android:copy-files",
    "info:ionic": "ionic info",
    "prettier": "prettier --write \"**/*.{js,ts,css,scss,html}\"",
    "prettier:check": "prettier --check \"**/*.{js,ts,css,scss,html}\"",
    "prettier-html": "prettier --write \"./apps/**/src/**/*.html\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@awesome-cordova-plugins/core": "^8.1.0",
    "@awesome-cordova-plugins/geolocation": "^8.1.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/core": "^8.1.0",
    "@capacitor/geolocation": "^8.1.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@ionic/angular": "^8.7.18",
    "@ionic/core": "^8.7.18",
    "@ionic/storage": "^4.0.0",
    "@ionic/storage-angular": "^4.0.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@trapezedev/configure": "^7.0.10",
    "@types/chartjs-plugin-annotation": "^0.5.5",
    "@types/geojson": "^7946.0.15",
    "@types/leaflet": "^1.9.12",
    "chart.js": "^4.4.0",
    "chartjs-plugin-annotation": "^3.0.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "cordova-plugin-geolocation": "^5.0.0",
    "cordova-sqlite-storage": "^6.0.0",
    "geojson-vt": "^3.2.1",
    "leaflet": "^1.9.4",
    "leaflet-geojson-vt": "^1.1.0",
    "localforage-cordovasqlitedriver": "^1.8.0",
    "lottie-web": "^5.13.0",
    "moment": "^2.30.1",
    "ngx-lottie": "^21.2.0",
    "rxjs": "^7.8.2",
    "swiper": "12.1.2",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-eslint/builder": "^21.0.0",
    "@angular-eslint/eslint-plugin": "^21.0.0",
    "@angular-eslint/eslint-plugin-template": "^21.0.0",
    "@angular-eslint/template-parser": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/language-service": "^21.0.0",
    "@capacitor/cli": "^8.1.0",
    "@ionic/angular-toolkit": "^11.0.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.9",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "husky": "^9.0.11",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "prettier": "3.2.5",
    "pretty-quick": "^4.0.0",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "resolutions": {
    "autoprefixer": "10.4.5"
  }
}
